* =============================================================================
* ATMEGA328P : complete ATmega328P (Arduino Uno) co-simulation model
*   simavr runs the .hex inside ngspice through d_cosim (mcu_cosim.so)
*
* Pins (all bidirectional, direction set by the firmware):
*   PD0..PD7 = D0..D7   PB0..PB5 = D8..D13   PC0..PC5 = A0..A5 (+ ADC0..5)
*   UART0: TXD = PD1 (frames rebuilt by the plug-in), text in uart_log.txt
*   I2C  : SDA = PC4 (A4), SCL = PC5 (A5), open drain: add pull-ups
*          (4.7k to 5 V) or enable the internal ones (Wire.begin does).
*          Virtual slaves: lm75 eeprom
*   SPI  : master, SCK = PB5 (D13), MOSI = PB3 (D11), MISO = PB4 (D12);
*          slaves are circuit parts, slave select = any GPIO (e.g. D10)
*
* KiCad: works with the official symbol MCU_Microchip_ATmega:ATmega328P-P;
*   Sim.Device = SUBCKT, Sim.Name = ATMEGA328P, Sim.Pins =
*   2=PD0 3=PD1 4=PD2 5=PD3 6=PD4 11=PD5 12=PD6 13=PD7 14=PB0 15=PB1 16=PB2 17=PB3 18=PB4 19=PB5 23=PC0 24=PC1 25=PC2 26=PC3 27=PC4 28=PC5
*   (VCC, GND, AVCC, AREF, RESET, XTAL1/2 are not simulated)
*
* New firmware: rerun tools/make_atmega328p_lib.py --hex <file> -o <lib>
* or edit the path after "hex". Keep the .so path in lower case.
* Generated by tools/make_atmega328p_lib.py
* =============================================================================

.model atmega328p_core d_cosim simulation="../build/mcu_cosim.so"
+ sim_args=["hex" "../firmware/i2c_lm75.hex" "mcu" "atmega328p" "freq" "16000000" "io"
+ "PD0" "PD1" "PD2" "PD3" "PD4" "PD5" "PD6" "PD7" "PB0" "PB1" "PB2" "PB3"
+ "PB4" "PB5" "PC0" "PC1" "PC2" "PC3" "PC4" "PC5" "adc" "0" "1" "2" "3" "4"
+ "5" "vref" "5" "adcbit" "1e-6" "uartlog" "../uart_log.txt" "i2c" "lm75"
+ "eeprom" "lm75temp" "20" "lm75rate" "1000"]
+ delay=100n

.model m328_in  adc_bridge(in_low=1.5 in_high=3.0)
.model m328_lvl dac_bridge(out_low=0 out_high=5 out_undef=0 t_rise=10n t_fall=10n)
.model m328_bit dac_bridge(out_low=0 out_high=1 out_undef=0 t_rise=10n t_fall=10n)
.model m328_drv aswitch(cntl_off=0.1 cntl_on=0.9 r_off=1e9 r_on=25 log=TRUE)
.model m328_pu  aswitch(cntl_off=0.1 cntl_on=0.9 r_off=1e12 r_on=35k log=TRUE)
.model m328_cmp adc_bridge(in_low=-0.1m in_high=0.1m)

.subckt ATMEGA328P PD0 PD1 PD2 PD3 PD4 PD5 PD6 PD7 PB0 PB1 PB2 PB3 PB4 PB5 PC0 PC1 PC2 PC3 PC4 PC5

* Internal supply for the pull-ups
Vcc5 vcc5 0 5

* Pin voltages read back by the MCU (CMOS thresholds 0.3 / 0.6 Vcc)
aIn [PD0 PD1 PD2 PD3 PD4 PD5 PD6 PD7 PB0 PB1 PB2 PB3 PB4 PB5 PC0 PC1 PC2 PC3 PC4
+ PC5]
+ [pd0_i pd1_i pd2_i pd3_i pd4_i pd5_i pd6_i pd7_i pb0_i pb1_i pb2_i pb3_i
+ pb4_i pb5_i pc0_i pc1_i pc2_i pc3_i pc4_i pc5_i] m328_in

* SAR ADC comparators: (An - vdac) > 0
Ec0 c0 0 PC0 vdac 1
Ec1 c1 0 PC1 vdac 1
Ec2 c2 0 PC2 vdac 1
Ec3 c3 0 PC3 vdac 1
Ec4 c4 0 PC4 vdac 1
Ec5 c5 0 PC5 vdac 1
aCmp [c0 c1 c2 c3 c4 c5] [c0_d c1_d c2_d c3_d c4_d c5_d] m328_cmp

* The MCU: inputs = pin reads + comparators,
*          outputs = (level, oe, pu) per pin + DAC bits b0..b9
aMcu [pd0_i pd1_i pd2_i pd3_i pd4_i pd5_i pd6_i pd7_i pb0_i pb1_i pb2_i pb3_i
+ pb4_i pb5_i pc0_i pc1_i pc2_i pc3_i pc4_i pc5_i c0_d c1_d c2_d c3_d c4_d
+ c5_d]
+ [pd0_l pd0_e pd0_p pd1_l pd1_e pd1_p pd2_l pd2_e pd2_p pd3_l pd3_e pd3_p
+ pd4_l pd4_e pd4_p pd5_l pd5_e pd5_p pd6_l pd6_e pd6_p pd7_l pd7_e pd7_p
+ pb0_l pb0_e pb0_p pb1_l pb1_e pb1_p pb2_l pb2_e pb2_p pb3_l pb3_e pb3_p
+ pb4_l pb4_e pb4_p pb5_l pb5_e pb5_p pc0_l pc0_e pc0_p pc1_l pc1_e pc1_p
+ pc2_l pc2_e pc2_p pc3_l pc3_e pc3_p pc4_l pc4_e pc4_p pc5_l pc5_e pc5_p b0
+ b1 b2 b3 b4 b5 b6 b7 b8 b9]
+ null atmega328p_core

* Pin drivers: 0/5 V level, output enable and pull-up enable
aLvl [pd0_l pd1_l pd2_l pd3_l pd4_l pd5_l pd6_l pd7_l pb0_l pb1_l pb2_l pb3_l
+ pb4_l pb5_l pc0_l pc1_l pc2_l pc3_l pc4_l pc5_l]
+ [pd0_o pd1_o pd2_o pd3_o pd4_o pd5_o pd6_o pd7_o pb0_o pb1_o pb2_o pb3_o
+ pb4_o pb5_o pc0_o pc1_o pc2_o pc3_o pc4_o pc5_o] m328_lvl
aCtl [pd0_e pd0_p pd1_e pd1_p pd2_e pd2_p pd3_e pd3_p pd4_e pd4_p pd5_e pd5_p
+ pd6_e pd6_p pd7_e pd7_p pb0_e pb0_p pb1_e pb1_p pb2_e pb2_p pb3_e pb3_p
+ pb4_e pb4_p pb5_e pb5_p pc0_e pc0_p pc1_e pc1_p pc2_e pc2_p pc3_e pc3_p
+ pc4_e pc4_p pc5_e pc5_p]
+ [pd0_ea pd0_pa pd1_ea pd1_pa pd2_ea pd2_pa pd3_ea pd3_pa pd4_ea pd4_pa pd5_ea
+ pd5_pa pd6_ea pd6_pa pd7_ea pd7_pa pb0_ea pb0_pa pb1_ea pb1_pa pb2_ea pb2_pa
+ pb3_ea pb3_pa pb4_ea pb4_pa pb5_ea pb5_pa pc0_ea pc0_pa pc1_ea pc1_pa pc2_ea
+ pc2_pa pc3_ea pc3_pa pc4_ea pc4_pa pc5_ea pc5_pa] m328_bit
aDpd0 pd0_ea (pd0_o PD0) m328_drv
aPpd0 pd0_pa (vcc5 PD0) m328_pu
aDpd1 pd1_ea (pd1_o PD1) m328_drv
aPpd1 pd1_pa (vcc5 PD1) m328_pu
aDpd2 pd2_ea (pd2_o PD2) m328_drv
aPpd2 pd2_pa (vcc5 PD2) m328_pu
aDpd3 pd3_ea (pd3_o PD3) m328_drv
aPpd3 pd3_pa (vcc5 PD3) m328_pu
aDpd4 pd4_ea (pd4_o PD4) m328_drv
aPpd4 pd4_pa (vcc5 PD4) m328_pu
aDpd5 pd5_ea (pd5_o PD5) m328_drv
aPpd5 pd5_pa (vcc5 PD5) m328_pu
aDpd6 pd6_ea (pd6_o PD6) m328_drv
aPpd6 pd6_pa (vcc5 PD6) m328_pu
aDpd7 pd7_ea (pd7_o PD7) m328_drv
aPpd7 pd7_pa (vcc5 PD7) m328_pu
aDpb0 pb0_ea (pb0_o PB0) m328_drv
aPpb0 pb0_pa (vcc5 PB0) m328_pu
aDpb1 pb1_ea (pb1_o PB1) m328_drv
aPpb1 pb1_pa (vcc5 PB1) m328_pu
aDpb2 pb2_ea (pb2_o PB2) m328_drv
aPpb2 pb2_pa (vcc5 PB2) m328_pu
aDpb3 pb3_ea (pb3_o PB3) m328_drv
aPpb3 pb3_pa (vcc5 PB3) m328_pu
aDpb4 pb4_ea (pb4_o PB4) m328_drv
aPpb4 pb4_pa (vcc5 PB4) m328_pu
aDpb5 pb5_ea (pb5_o PB5) m328_drv
aPpb5 pb5_pa (vcc5 PB5) m328_pu
aDpc0 pc0_ea (pc0_o PC0) m328_drv
aPpc0 pc0_pa (vcc5 PC0) m328_pu
aDpc1 pc1_ea (pc1_o PC1) m328_drv
aPpc1 pc1_pa (vcc5 PC1) m328_pu
aDpc2 pc2_ea (pc2_o PC2) m328_drv
aPpc2 pc2_pa (vcc5 PC2) m328_pu
aDpc3 pc3_ea (pc3_o PC3) m328_drv
aPpc3 pc3_pa (vcc5 PC3) m328_pu
aDpc4 pc4_ea (pc4_o PC4) m328_drv
aPpc4 pc4_pa (vcc5 PC4) m328_pu
aDpc5 pc5_ea (pc5_o PC5) m328_drv
aPpc5 pc5_pa (vcc5 PC5) m328_pu

* 10-bit DAC of the SAR converter: vdac = 5 V * code / 1024
aDac [b0 b1 b2 b3 b4 b5 b6 b7 b8 b9] [d0 d1 d2 d3 d4 d5 d6 d7 d8 d9] m328_bit
Bdac vdac 0 V = 5 * (v(d0) + 2*v(d1) + 4*v(d2) + 8*v(d3) + 16*v(d4) + 32*v(d5)
+ + 64*v(d6) + 128*v(d7) + 256*v(d8) + 512*v(d9)) / 1024

.ends ATMEGA328P
