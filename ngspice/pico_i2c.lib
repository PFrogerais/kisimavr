* =============================================================================
* PICO : Raspberry Pi Pico (RP2040) co-simulation model (kisimavr)
*   rp2040js (Wokwi) runs the firmware inside mcu_cosim.so
*   (QuickJS, d_cosim)
*
* GPIO: 3.3 V, bidirectional, direction and pulls set by the firmware.
*   UART0: TX = GP0 / GP12 / GP16, RX = GP1 / GP13 / GP17 (frames rebuilt by the
*   plug-in); UART1 on GP4 / GP5, GP8 / GP9; text in uart_log.txt. USB serial
*   (Serial of Arduino-pico): text only. ADC0..3 = GP26..GP29 (SAR, 12 bits).
*   Inside the model, as on the board: GP25 = LED (470 ohm), GP24 = VBUS sense
*   (5.6k / 10k), GP29 = ADC3 = VSYS / 3 (200k / 100k, 1 nF), GP23 free.
*   Ground = node 0 (pins 3 8 13 18 23 28 33 38 of the board).
*
* KiCad: Sim.Device = SUBCKT, Sim.Name = PICO_I2C, Sim.Pins =
*   1=GP0 2=GP1 4=GP2 5=GP3 6=GP4 7=GP5 9=GP6 10=GP7 11=GP8 12=GP9 14=GP10 15=GP11 16=GP12 17=GP13 19=GP14 20=GP15 21=GP16 22=GP17 24=GP18 25=GP19 26=GP20 27=GP21 29=GP22 30=RUN 31=GP26 32=GP27 34=GP28 35=ADC_VREF 36=V3V3 37=V3V3_EN 39=VSYS 40=VBUS
*
* New firmware: rerun tools/make_picoi2c_lib.py --fw <file> -o <lib>
* or edit the path after "fw". Keep the .so path in lower case.
* Generated by tools/make_picoi2c_lib.py
* =============================================================================

.model picoi2c_core d_cosim simulation="../build/mcu_cosim.so"
+ sim_args=["mcu" "rp2040" "fw" "../firmware/pico/picoi2c_i2c.bin" "io" "GP0" "GP1" "GP2"
+ "GP3" "GP4" "GP5" "GP6" "GP7" "GP8" "GP9" "GP10" "GP11" "GP12" "GP13"
+ "GP14" "GP15" "GP16" "GP17" "GP18" "GP19" "GP20" "GP21" "GP22" "GP26"
+ "GP27" "GP28" "GP23" "GP24" "GP25" "GP29" "adc" "0" "1" "2" "3" "uartlog"
+ "../uart_log.txt"]
+ delay=100n

.model picoi2c_in  adc_bridge(in_low=0.8 in_high=2.0)
.model picoi2c_lvl dac_bridge(out_low=0 out_high=3.3 out_undef=0 t_rise=5n t_fall=5n)
.model picoi2c_bit dac_bridge(out_low=0 out_high=1 out_undef=0 t_rise=5n t_fall=5n)
.model picoi2c_drv aswitch(cntl_off=0.1 cntl_on=0.9 r_off=1e9 r_on=50 log=TRUE)
.model picoi2c_pul aswitch(cntl_off=0.1 cntl_on=0.9 r_off=1e12 r_on=50k log=TRUE)
.model picoi2c_cmp adc_bridge(in_low=-0.1m in_high=0.1m)
.model picoi2c_led D(IS=1e-19 RS=10 N=2)

.subckt PICO_I2C GP0 GP1 GP2 GP3 GP4 GP5 GP6 GP7 GP8 GP9 GP10 GP11 GP12 GP13 GP14 GP15 GP16 GP17 GP18 GP19 GP20 GP21 GP22 GP26 GP27 GP28 VBUS VSYS V3V3_EN V3V3 ADC_VREF RUN

* Internal 3.3 V of the I/O drivers
V33 v33 0 3.3
* 3.3 V regulator output (ideal), ADC reference through 200 ohm (as on the board)
R33 v33 V3V3 0.1
Rvref V3V3 ADC_VREF 200
* Power and control inputs: VSYS / 3 divider on GP29, VBUS sense on GP24
Rvbus VBUS GP24 5.6k
Rsense GP24 0 10k
Rsys1 VSYS GP29 200k
Rsys2 GP29 0 100k
Csys GP29 0 1n
Ren V3V3_EN VSYS 100k
Rrun RUN V3V3 50k
* On-board LED on GP25; GP23 (SMPS mode) without load
Rled GP25 led 470
Dled led 0 picoi2c_led
Rgp23 GP23 0 10meg

* Pin voltages read back by the RP2040
aIn [GP0 GP1 GP2 GP3 GP4 GP5 GP6 GP7 GP8 GP9 GP10 GP11 GP12 GP13 GP14 GP15 GP16
+ GP17 GP18 GP19 GP20 GP21 GP22 GP26 GP27 GP28 GP23 GP24 GP25 GP29]
+ [gp0_i gp1_i gp2_i gp3_i gp4_i gp5_i gp6_i gp7_i gp8_i gp9_i gp10_i gp11_i
+ gp12_i gp13_i gp14_i gp15_i gp16_i gp17_i gp18_i gp19_i gp20_i gp21_i
+ gp22_i gp26_i gp27_i gp28_i gp23_i gp24_i gp25_i gp29_i] picoi2c_in

* SAR ADC comparators: (GPn - vdac) > 0
Ec0 c0 0 GP26 vdac 1
Ec1 c1 0 GP27 vdac 1
Ec2 c2 0 GP28 vdac 1
Ec3 c3 0 GP29 vdac 1
aCmp [c0 c1 c2 c3] [c0_d c1_d c2_d c3_d] picoi2c_cmp

* The RP2040: inputs = pin reads + comparators,
*             outputs = (level, oe, pu, pd) per pin + DAC bits b0..b11
aMcu [gp0_i gp1_i gp2_i gp3_i gp4_i gp5_i gp6_i gp7_i gp8_i gp9_i gp10_i gp11_i
+ gp12_i gp13_i gp14_i gp15_i gp16_i gp17_i gp18_i gp19_i gp20_i gp21_i
+ gp22_i gp26_i gp27_i gp28_i gp23_i gp24_i gp25_i gp29_i c0_d c1_d c2_d
+ c3_d]
+ [gp0_l gp0_e gp0_u gp0_d gp1_l gp1_e gp1_u gp1_d gp2_l gp2_e gp2_u gp2_d
+ gp3_l gp3_e gp3_u gp3_d gp4_l gp4_e gp4_u gp4_d gp5_l gp5_e gp5_u gp5_d
+ gp6_l gp6_e gp6_u gp6_d gp7_l gp7_e gp7_u gp7_d gp8_l gp8_e gp8_u gp8_d
+ gp9_l gp9_e gp9_u gp9_d gp10_l gp10_e gp10_u gp10_d gp11_l gp11_e gp11_u
+ gp11_d gp12_l gp12_e gp12_u gp12_d gp13_l gp13_e gp13_u gp13_d gp14_l
+ gp14_e gp14_u gp14_d gp15_l gp15_e gp15_u gp15_d gp16_l gp16_e gp16_u
+ gp16_d gp17_l gp17_e gp17_u gp17_d gp18_l gp18_e gp18_u gp18_d gp19_l
+ gp19_e gp19_u gp19_d gp20_l gp20_e gp20_u gp20_d gp21_l gp21_e gp21_u
+ gp21_d gp22_l gp22_e gp22_u gp22_d gp26_l gp26_e gp26_u gp26_d gp27_l
+ gp27_e gp27_u gp27_d gp28_l gp28_e gp28_u gp28_d gp23_l gp23_e gp23_u
+ gp23_d gp24_l gp24_e gp24_u gp24_d gp25_l gp25_e gp25_u gp25_d gp29_l
+ gp29_e gp29_u gp29_d b0 b1 b2 b3 b4 b5 b6 b7 b8 b9 b10 b11]
+ null picoi2c_core

* Pin drivers: 0 / 3.3 V level, output enable, pull-up, pull-down
aLvl [gp0_l gp1_l gp2_l gp3_l gp4_l gp5_l gp6_l gp7_l gp8_l gp9_l gp10_l gp11_l
+ gp12_l gp13_l gp14_l gp15_l gp16_l gp17_l gp18_l gp19_l gp20_l gp21_l
+ gp22_l gp26_l gp27_l gp28_l gp23_l gp24_l gp25_l gp29_l]
+ [gp0_o gp1_o gp2_o gp3_o gp4_o gp5_o gp6_o gp7_o gp8_o gp9_o gp10_o gp11_o
+ gp12_o gp13_o gp14_o gp15_o gp16_o gp17_o gp18_o gp19_o gp20_o gp21_o
+ gp22_o gp26_o gp27_o gp28_o gp23_o gp24_o gp25_o gp29_o] picoi2c_lvl
aCtl [gp0_e gp0_u gp0_d gp1_e gp1_u gp1_d gp2_e gp2_u gp2_d gp3_e gp3_u gp3_d
+ gp4_e gp4_u gp4_d gp5_e gp5_u gp5_d gp6_e gp6_u gp6_d gp7_e gp7_u gp7_d
+ gp8_e gp8_u gp8_d gp9_e gp9_u gp9_d gp10_e gp10_u gp10_d gp11_e gp11_u
+ gp11_d gp12_e gp12_u gp12_d gp13_e gp13_u gp13_d gp14_e gp14_u gp14_d
+ gp15_e gp15_u gp15_d gp16_e gp16_u gp16_d gp17_e gp17_u gp17_d gp18_e
+ gp18_u gp18_d gp19_e gp19_u gp19_d gp20_e gp20_u gp20_d gp21_e gp21_u
+ gp21_d gp22_e gp22_u gp22_d gp26_e gp26_u gp26_d gp27_e gp27_u gp27_d
+ gp28_e gp28_u gp28_d gp23_e gp23_u gp23_d gp24_e gp24_u gp24_d gp25_e
+ gp25_u gp25_d gp29_e gp29_u gp29_d]
+ [gp0_ea gp0_ua gp0_da gp1_ea gp1_ua gp1_da gp2_ea gp2_ua gp2_da gp3_ea
+ gp3_ua gp3_da gp4_ea gp4_ua gp4_da gp5_ea gp5_ua gp5_da gp6_ea gp6_ua
+ gp6_da gp7_ea gp7_ua gp7_da gp8_ea gp8_ua gp8_da gp9_ea gp9_ua gp9_da
+ gp10_ea gp10_ua gp10_da gp11_ea gp11_ua gp11_da gp12_ea gp12_ua gp12_da
+ gp13_ea gp13_ua gp13_da gp14_ea gp14_ua gp14_da gp15_ea gp15_ua gp15_da
+ gp16_ea gp16_ua gp16_da gp17_ea gp17_ua gp17_da gp18_ea gp18_ua gp18_da
+ gp19_ea gp19_ua gp19_da gp20_ea gp20_ua gp20_da gp21_ea gp21_ua gp21_da
+ gp22_ea gp22_ua gp22_da gp26_ea gp26_ua gp26_da gp27_ea gp27_ua gp27_da
+ gp28_ea gp28_ua gp28_da gp23_ea gp23_ua gp23_da gp24_ea gp24_ua gp24_da
+ gp25_ea gp25_ua gp25_da gp29_ea gp29_ua gp29_da] picoi2c_bit
aDgp0 gp0_ea (gp0_o GP0) picoi2c_drv
aUgp0 gp0_ua (v33 GP0) picoi2c_pul
aPgp0 gp0_da (GP0 0) picoi2c_pul
aDgp1 gp1_ea (gp1_o GP1) picoi2c_drv
aUgp1 gp1_ua (v33 GP1) picoi2c_pul
aPgp1 gp1_da (GP1 0) picoi2c_pul
aDgp2 gp2_ea (gp2_o GP2) picoi2c_drv
aUgp2 gp2_ua (v33 GP2) picoi2c_pul
aPgp2 gp2_da (GP2 0) picoi2c_pul
aDgp3 gp3_ea (gp3_o GP3) picoi2c_drv
aUgp3 gp3_ua (v33 GP3) picoi2c_pul
aPgp3 gp3_da (GP3 0) picoi2c_pul
