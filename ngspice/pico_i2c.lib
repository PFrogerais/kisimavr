aDgp12 gp12_ea (gp12_o GP12) picoi2c_drv
aUgp12 gp12_ua (v33 GP12) picoi2c_pul
aPgp12 gp12_da (GP12 0) picoi2c_pul
aDgp13 gp13_ea (gp13_o GP13) picoi2c_drv
aUgp13 gp13_ua (v33 GP13) picoi2c_pul
aPgp13 gp13_da (GP13 0) picoi2c_pul
