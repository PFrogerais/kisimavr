* =============================================================================
* LCD1602 : character LCD 16x2, HD44780 controller (kisimavr)
*   The controller runs in mcu_cosim.so (d_cosim, "device" "hd44780"): each
*   screen is printed in the terminal and in the lcdlog file.
*
* Pins: 1 VSS  2 VDD  3 VO  4 RS  5 R/W  6 E  7..14 D0..D7  15 LED+  16 LED-
*   4-bit wiring (LiquidCrystal): D4..D7 only, D0..D3 left open.
*   R/W: tie to GND (read cycles are not modelled).
*
* KiCad: works with the official symbol Display_Character:WC1602A;
*   Sim.Device = SUBCKT, Sim.Name = LCD1602, Sim.Pins =
*   1=VSS 2=VDD 3=VO 4=RS 5=RW 6=E 7=D0 8=D1 9=D2 10=D3 11=D4 12=D5 13=D6 14=D7 15=LEDP 16=LEDN
*
* Several co-simulated parts: each needs its own d_cosim rank (here 10,
*   option --irreversible; the MCU keeps 1).
* Generated by tools/make_lcd_lib.py
* =============================================================================

.model lcd1602_core d_cosim simulation="../build/mcu_cosim.so"
+ sim_args=["device" "hd44780" "cols" "16" "rows" "2" "name" "LCD" "lcdlog"
+ "../lcd_log.txt"]
+ irreversible=10
.model lcd1602_in adc_bridge(in_low=1.5 in_high=3.5)
.model lcd1602_bl D(IS=1e-20 N=2.6 RS=5)

.subckt LCD1602 VSS VDD VO RS RW E D0 D1 D2 D3 D4 D5 D6 D7 LEDP LEDN
* Inputs read by the controller (falling edge of E)
aIn [RS RW E D0 D1 D2 D3 D4 D5 D6 D7]
+ [d_rs d_rw d_e d_d0 d_d1 d_d2 d_d3 d_d4 d_d5 d_d6 d_d7] lcd1602_in
aLcd [d_rs d_rw d_e d_d0 d_d1 d_d2 d_d3 d_d4 d_d5 d_d6 d_d7] null null lcd1602_core
* Internal pull-ups (about 100 uA at 5 V) on RS, R/W, D0..D7
Rpurs RS VDD 50k
Rpurw RW VDD 50k
Rpud0 D0 VDD 50k
Rpud1 D1 VDD 50k
Rpud2 D2 VDD 50k
Rpud3 D3 VDD 50k
Rpud4 D4 VDD 50k
Rpud5 D5 VDD 50k
Rpud6 D6 VDD 50k
Rpud7 D7 VDD 50k
* E: high impedance input
Re E VSS 10meg
* Supply current of the module (about 1.5 mA at 5 V)
Rsupply VDD VSS 3.3k
* Contrast input (not modelled)
Rvo VO VSS 1meg
* Backlight LED
Dbl LEDP LEDN lcd1602_bl
.ends LCD1602
