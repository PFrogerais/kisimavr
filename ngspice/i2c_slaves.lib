* =============================================================================
* I2C_SLAVES : I2C slaves (kisimavr): LM75 0x48, LCD 16x2 PCF8574 0x27
*   Decoded bit by bit in mcu_cosim.so (d_cosim, "device" "i2c"): ACK and
*   data bits pull SDA low (open drain, 50 ohm). Any master works.
*
* Pins: 1 GND  2 VCC  3 SDA  4 SCL   (pull-ups of the bus: in the schematic)
*   KiCad: a 4-pin connector symbol (Connector_Generic:Conn_01x04) or any
*   symbol; Sim.Device = SUBCKT, Sim.Name = I2C_SLAVES,
*   Sim.Pins = 1=GND 2=VCC 3=SDA 4=SCL
*
* Several co-simulated parts: each needs its own d_cosim rank (here 11,
*   option --irreversible; the MCU keeps 1, an LCD 10).
* Generated by tools/make_i2c_lib.py
* =============================================================================

.model i2c_slaves_core d_cosim simulation="../build/mcu_cosim.so"
+ sim_args=["device" "i2c" "lm75" "0x48" "lcd" "0x27" "temp" "25.5" "rate" "0" "cols"
+ "16" "rows" "2" "lcdlog" "../lcd_log.txt" "log" "1"]
+ irreversible=11
.model i2c_slaves_in adc_bridge(in_low=1.5 in_high=3.5)
.model i2c_slaves_bit dac_bridge(out_low=0 out_high=1 out_undef=0 t_rise=10n t_fall=10n)
.model i2c_slaves_od aswitch(cntl_off=0.1 cntl_on=0.9 r_off=1e9 r_on=50 log=TRUE)

.subckt I2C_SLAVES GND VCC SDA SCL
* Levels scaled to a 5 V supply: thresholds 30 % / 70 % of VCC
Bvs vs 0 V = max(V(VCC,GND), 1)
Bsda n_sda 0 V = V(SDA,GND) * 5 / V(vs)
Bscl n_scl 0 V = V(SCL,GND) * 5 / V(vs)
aIn [n_sda n_scl] [d_sda d_scl] i2c_slaves_in
aBus [d_sda d_scl] [d_pull] null i2c_slaves_core
* SDA pulled low by the slaves (open drain)
aPull [d_pull] [pull] i2c_slaves_bit
aOd pull (SDA GND) i2c_slaves_od
* Inputs: high impedance; supply current of the modules (about 1 mA)
Rsda SDA GND 10meg
Rscl SCL GND 10meg
Rsupply VCC GND 3.3k
.ends I2C_SLAVES
