* =============================================================================
* HCSR04 : HC-SR04 ultrasonic distance sensor (kisimavr), obstacle at 40 cm, -100 cm/s
*   Timing in mcu_cosim.so (d_cosim, "device" "hcsr04"): TRIG >= 10 us, ECHO
*   high 250 us after TRIG falls, for 58.3 us per cm (38 ms: out of range).
*
* Pins: VCC TRIG ECHO GND (header of the module); ECHO at the VCC level
*   KiCad: Sim.Device = SUBCKT, Sim.Name = HCSR04, e.g. on a 4-pin connector:
*   Sim.Pins = 1=VCC 2=TRIG 3=ECHO 4=GND
* d_cosim rank 14 (--irreversible): distinct from the other parts.
* Generated by tools/make_module_lib.py
* =============================================================================

.model hcsr04_core d_cosim simulation="../build/mcu_cosim.so"
+ sim_args=["device" "hcsr04" "dist" "40" "rate" "-100" "name" "HCSR04" "log" "1"]
+ irreversible=14
.model hcsr04_in adc_bridge(in_low=0.8 in_high=2.0)
.model hcsr04_bit dac_bridge(out_low=0 out_high=1 out_undef=0 t_rise=50n t_fall=50n)

.subckt HCSR04 VCC TRIG ECHO GND
aIn [TRIG] [d_trig] hcsr04_in
aSensor [d_trig] [d_echo] null hcsr04_core
aEcho [d_echo] [echo_l] hcsr04_bit
* ECHO output: 0 / VCC through 100 ohm
Becho GND ECHO I = (V(echo_l) * V(VCC,GND) - V(ECHO,GND)) / 100
* TRIG input (10 kohm pull-down), supply current (about 15 mA at 5 V)
Rtrig TRIG GND 10k
Rsupply VCC GND 330
.ends HCSR04
