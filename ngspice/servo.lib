* =============================================================================
* SERVO : RC servomotor (kisimavr), 544..2400 us -> 0..180 deg, 600 deg/s
*   Pulse widths measured in mcu_cosim.so (d_cosim, "device" "servo"):
*   SERVO> 90 deg (pulse 1472 us) is printed for each position reached.
*
* Pins: SIG VCC GND ANGLE   (ANGLE: voltage output, 1 V = 1 degree)
*   KiCad: Sim.Device = SUBCKT, Sim.Name = SERVO
* d_cosim rank 13 (--irreversible): distinct from the other parts.
* Generated by tools/make_module_lib.py
* =============================================================================

.model servo_core d_cosim simulation="../build/mcu_cosim.so"
+ sim_args=["device" "servo" "min" "544" "max" "2400" "speed" "600" "start" "90"
+ "name" "SERVO"]
+ irreversible=13
.model servo_in adc_bridge(in_low=1.2 in_high=1.6)
.model servo_bit dac_bridge(out_low=0 out_high=1 out_undef=0 t_rise=1u t_fall=1u)

.subckt SERVO SIG VCC GND ANGLE
aIn [SIG] [d_sig] servo_in
aServo [d_sig] [b0 b1 b2 b3 b4 b5 b6 b7] null servo_core
aBits [b0 b1 b2 b3 b4 b5 b6 b7] [a0 a1 a2 a3 a4 a5 a6 a7] servo_bit
* Angle in degrees (1 V = 1 deg)
Bangle ANGLE GND V = 1*V(a0) + 2*V(a1) + 4*V(a2) + 8*V(a3) + 16*V(a4) + 32*V(a5) + 64*V(a6) + 128*V(a7)
* Signal input (about 10 kohm), supply current at rest (about 10 mA at 5 V)
Rsig SIG GND 10k
Rsupply VCC GND 500
.ends SERVO
