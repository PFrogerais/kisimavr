* ATmega328P co-simulation model: simavr runs the .hex inside ngspice (d_cosim)
*
* Pins : PD2 (input), PB5 PB0 (outputs) - extend the lists to add pins.
* Edit : the two paths in the mcu_core model (absolute paths are safest).
* Needs: ngspice >= 42 with XSPICE code models, mcu_cosim.so (this project).
*
* numparam pitfalls (ngspice preprocessor):
*  - keep the d_cosim .model OUTSIDE the .subckt;
*  - never write "key=value" or "key:value" inside sim_args: give each key
*    and each value as its own string, one pin per string.

.model mcu_core d_cosim simulation="/home/paul/dev/kisimavr/build/mcu_cosim.so"
+ sim_args=["hex" "/home/paul/dev/kisimavr/firmware/blink.hex" "mcu" "atmega328p" "freq" "16000000"
+           "in" "PD2" "out" "PB5" "PB0"]

.model mcu_in  adc_bridge(in_low=1.5 in_high=3.0)
.model mcu_out dac_bridge(out_low=0 out_high=5 out_undef=0 t_rise=10n t_fall=10n)

.subckt ATMEGA328P_COSIM PD2 PB5 PB0

* Analog -> digital (CMOS 5 V thresholds: VIL = 0.3 Vcc, VIH = 0.6 Vcc)
aIn  [PD2] [pd2_d] mcu_in

* The MCU itself
aMcu [pd2_d] [pb5_d pb0_d] null mcu_core

* Digital -> analog, with a 25 ohm output resistance per pin
aOut [pb5_d pb0_d] [pb5_a pb0_a] mcu_out
Rpb5 pb5_a PB5 25
Rpb0 pb0_a PB0 25

.ends ATMEGA328P_COSIM

* =============================================================================
* ATMEGA328P_ADC : analog input demo (firmware/adc_pwm.c)
*   ADC0 (analog in) -> PD6 PWM, PB5 = (ADC0 >= Vref/2)
*
* SAR model: the plug-in drives a 10-bit code (b0..b9), Bdac turns it into
* vdac = 5 V * code / 1024, and the comparator returns (ADC0 > vdac).
* Plot v(xu1.vdac) (KiCad: xu1 = lower-case reference) to watch the SAR.
* "vref" in sim_args and the 5 in Bdac must be the same AVCC value.
* delay=100n: the SAR produces an output event every microsecond; a larger
* d_cosim output delay lets ngspice place its timesteps after the MCU
* events (avoids "XSPICE time is behind vtime"). Outputs lag by 100 ns.
* =============================================================================

.model mcu_adc_core d_cosim simulation="/home/paul/dev/kisimavr/build/mcu_cosim.so"
+ sim_args=["hex" "/home/paul/dev/kisimavr/firmware/adc_pwm.hex" "mcu" "atmega328p" "freq" "16000000"
+           "out" "PD6" "PB5" "adc" "0" "vref" "5" "adcbit" "1e-6"]
+ delay=100n

.model mcu_cmp   adc_bridge(in_low=-0.1m in_high=0.1m)
.model mcu_dac01 dac_bridge(out_low=0 out_high=1 out_undef=0 t_rise=10n t_fall=10n)

.subckt ATMEGA328P_ADC ADC0 PD6 PB5

* Comparator: ADC0 - vdac -> digital
Ecmp cmp0 0 ADC0 vdac 1
aCmp [cmp0] [cmp0_d] mcu_cmp
Rin  ADC0 0 100Meg

* The MCU: inputs = [comparator], outputs = [PD6 PB5 b0..b9]
aMcu [cmp0_d] [pd6_d pb5_d b0 b1 b2 b3 b4 b5 b6 b7 b8 b9] null mcu_adc_core

* GPIO outputs, 25 ohm per pin
aOut [pd6_d pb5_d] [pd6_a pb5_a] mcu_out
Rpd6 pd6_a PD6 25
Rpb5 pb5_a PB5 25

* 10-bit DAC of the SAR converter
aDac [b0 b1 b2 b3 b4 b5 b6 b7 b8 b9] [d0 d1 d2 d3 d4 d5 d6 d7 d8 d9] mcu_dac01
Bdac vdac 0 V = 5 * (v(d0) + 2*v(d1) + 4*v(d2) + 8*v(d3) + 16*v(d4) + 32*v(d5)
+ + 64*v(d6) + 128*v(d7) + 256*v(d8) + 512*v(d9)) / 1024

.ends ATMEGA328P_ADC

* =============================================================================
* ATMEGA328P_UART : serial console demo (firmware/uart_adc.c)
*   ADC0 (analog in) -> text "ADC0 = 512 (2500 mV)" on UART0, 115200 bauds
*   TXD (PD1): serial frames rebuilt by the plug-in, visible in the plots.
*   Text  : printed on stderr ("UART0> ...") and written to uartlog.
*   Trace : PD1 in the vcd file -> PulseView, UART decoder at 115200 bauds.
* =============================================================================

.model mcu_uart_core d_cosim simulation="/home/paul/dev/kisimavr/build/mcu_cosim.so"
+ sim_args=["hex" "/home/paul/dev/kisimavr/firmware/uart_adc.hex" "mcu" "atmega328p" "freq" "16000000"
+           "out" "PD1" "adc" "0" "vref" "5" "adcbit" "1e-6"
+           "uartlog" "/home/paul/dev/kisimavr/uart_log.txt" "vcd" "/home/paul/dev/kisimavr/uart_trace.vcd"]
+ delay=100n

.subckt ATMEGA328P_UART ADC0 TXD

* SAR ADC on ADC0 (see ATMEGA328P_ADC)
Ecmp cmp0 0 ADC0 vdac 1
aCmp [cmp0] [cmp0_d] mcu_cmp
Rin  ADC0 0 100Meg
aDac [b0 b1 b2 b3 b4 b5 b6 b7 b8 b9] [d0 d1 d2 d3 d4 d5 d6 d7 d8 d9] mcu_dac01
Bdac vdac 0 V = 5 * (v(d0) + 2*v(d1) + 4*v(d2) + 8*v(d3) + 16*v(d4) + 32*v(d5)
+ + 64*v(d6) + 128*v(d7) + 256*v(d8) + 512*v(d9)) / 1024

* The MCU: inputs = [comparator], outputs = [PD1 b0..b9]
aMcu [cmp0_d] [pd1_d b0 b1 b2 b3 b4 b5 b6 b7 b8 b9] null mcu_uart_core

* TXD output, 25 ohm
aOut [pd1_d] [pd1_a] mcu_out
Rpd1 pd1_a TXD 25

.ends ATMEGA328P_UART
